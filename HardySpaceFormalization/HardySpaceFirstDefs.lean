    have hre : ⨆ z : unitDisc, ENNReal.ofReal ‖f z.1‖ ≤ hardyNorm f ∞ := by sorry
    exact le_antisymm hle hre-/

/-- Membership in the Hardy space `H^p` on the unit disc. -/
def MemHpDisc
    (p : ℝ≥0∞) (f : ℂ → E) : Prop :=
  AnalyticOn ℂ f unitDisc ∧ hardyNorm f p < ∞

/-- Membership in `H^∞`, the space of bounded analytic functions on unit disc. -/
abbrev MemHInfinityDisc (f : ℂ → E) : Prop :=
  MemHpDisc ∞ f

/-- `H^p` space over unit disc. -/
def HpDisc (p : ℝ≥0∞) : Submodule ℂ (ℂ → E) where
  carrier := {f : ℂ → E | MemHpDisc (E := E) p f}
  add_mem' := by
     intro a b ha hb
     unfold MemHpDisc at *
     rw [Set.mem_setOf_eq] at *
     rcases ha with ⟨ha_ana , ha_norm⟩
     rcases hb with ⟨hb_ana , hb_norm⟩
     constructor
     . exact AnalyticOn.add ha_ana hb_ana
     . unfold hardyNorm at *
       sorry
  zero_mem' := by
    rw [Set.mem_setOf_eq]
    unfold MemHpDisc
    constructor
    . exact analyticOn_const
    . unfold hardyNorm
      by_cases hp : p = 0
      . simp [hp]
      . simp [hp]; by_cases hi : p = ∞
        . simp [hi]
        . simp [hi]; rw [ENNReal.zero_rpow_of_pos ?_]; simp; simp;
          -- why I have to `simp` twice here
          rw [ENNReal.toReal_pos_iff]
          rw [← ne_eq p 0] at hp
          rw [← ne_eq p ⊤] at hi
          constructor
          . exact pos_of_ne_zero hp
          . exact Ne.lt_top' (id (Ne.symm hi))
  smul_mem' := by
     intro c f hf
     rw [Set.mem_setOf] at *
     unfold MemHpDisc at *
     rcases hf with ⟨hf_an, hf_norm⟩
     constructor
     . exact AnalyticOn.const_smul hf_an
     . unfold hardyNorm at *
       by_cases hp : p = 0
       . simp [hp]
       . simp [hp] at *; by_cases hi : p = ∞
         . simp [hi] at *; sorry
         . simp [hi] at *; sorry






namespace HpDisc


instance instNorm (p : ℝ≥0∞) : Norm (HpDisc (E := E) p) where
  norm f := (hardyNorm (E := E) f.1 p).toReal

instance instDist (p : ℝ≥0∞)  : Dist (HpDisc (E := E) p) where
  dist f g := ‖- f + g‖

instance instEDist (p : ℝ≥0∞)  : EDist (HpDisc (E := E) p) where
  edist f g := hardyNorm (E := E) (f.1 - g.1) p


@[simp] lemma norm_def (p : ℝ≥0∞) (f : HpDisc (E := E) p)  :
    ‖f‖ = (hardyNorm (E := E) f.1 p).toReal := rfl

@[simp] lemma norm_zero (p : ℝ≥0∞)  :
    ‖(0 : HpDisc (E := E) p)‖ = 0 := by
  simp [hardyNorm]
  by_cases hp : p = 0
  . simp [hp]
  . simp [hp]; by_cases hi : p = ∞
    . simp [hi]
    . simp [hi]
      rw [ENNReal.zero_rpow_of_pos ?_]
      . simp
      . apply lt_min
        . rw [ENNReal.toReal_pos_iff]
          constructor
          . rw [pos_iff_ne_zero]; simpa
          . rw [lt_top_iff_ne_top]; simpa
        . exact Real.zero_lt_one

