      = eLpNorm (fun θ : ℝ => f (↑r * cexp (I * ↑θ))) p μ := by
        sorry
      congr; ext r; congr; ext x; congr 1; exact eLpNorm_radial_neg p
        ((ENNReal.ofReal (π⁻¹ * 2⁻¹)) • volume.restrict (Set.Ico 0 (2 * π))) f.1 r

