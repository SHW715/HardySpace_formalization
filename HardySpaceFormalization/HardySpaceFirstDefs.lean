  by_cases hp : p = 0
  . simp [hp]
  . simp [hp]; by_cases hi : p = ∞
    . simp [hi]
    . simp [hi]
      have eLpNorm_radial_neg (p : ℝ≥0∞) (μ : Measure ℝ) (f : ℂ → E) (r : ℝ) :
